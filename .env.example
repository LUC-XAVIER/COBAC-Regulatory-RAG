# Copy to .env and fill in. Never commit .env.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Database (used by docker-compose.yml and by the app). Keep the two passwords identical.
# Use letters, digits, "-" and "_" only, so the password is safe inside the URL.
POSTGRES_USER=cobac
POSTGRES_PASSWORD=
POSTGRES_DB=cobac_rag
DATABASE_URL=postgresql+psycopg://cobac:PASSWORD@127.0.0.1:5433/cobac_rag
